# Supabase connection — copy this file to .env.local and fill in.
#
# LOCAL DEV (recommended): run `pnpm run setup` and these two values are filled
# in automatically from the local Docker stack. You don't need to edit them.
#
# HOSTED PROJECT: get these from https://app.supabase.com/project/_/settings/api
#   NEXT_PUBLIC_SUPABASE_URL                -> Project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY    -> Publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Set SKIP_ENV_VALIDATION=1 to bypass env validation during builds without
# real credentials (e.g. CI image builds). Not needed for normal local dev.
# SKIP_ENV_VALIDATION=1
