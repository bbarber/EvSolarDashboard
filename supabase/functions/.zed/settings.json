{
  // Nested local settings: within supabase/functions/ the Deno LSP takes
  // over and the Node TS servers stand down. The rest of the repo is
  // untouched (Zed applies these to this subtree only). No `formatter`
  // override — Prettier owns formatting repo-wide (deno fmt is disabled).
  // Requires the Zed Deno extension (one-time manual install).
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint"
      ]
    },
    "JavaScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint"
      ]
    }
  }
}
